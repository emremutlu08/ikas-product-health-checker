
NODE_ENV = production
NEXT_PUBLIC_GRAPH_API_URL = https://api.myikas.com/api/v2/admin/graphql
NEXT_PUBLIC_ADMIN_URL = https://{storeName}.myikas.com/admin
NEXT_PUBLIC_DEPLOY_URL = http://localhost:3000

SECRET_COOKIE_PASSWORD = your_session_cookie_password_here
NEXT_PUBLIC_CLIENT_ID = your_store_app_id_here
CLIENT_SECRET = your_store_app_secret_here

# Production durable storage (server-only; both required)
UPSTASH_REDIS_REST_URL = https://your-redis-endpoint.example.com
UPSTASH_REDIS_REST_TOKEN = your_redis_rest_token_here

# Daily Pro monitoring (server-only)
CRON_SECRET = replace_with_at_least_32_random_characters
IKAS_MONITORING_SCHEDULER_ENABLED = false
RESEND_API_KEY = re_your_resend_api_key
IKAS_EMAIL_FROM = Product Health <health@example.com>
IKAS_VERIFIED_EMAIL_RECIPIENTS_JSON = [{"authorizedAppId":"app-id","merchantId":"merchant-id","email":"owner@example.com","verified":true}]
